NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement : création des comptes par l'administrateur (invitations), tâches planifiées
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://pcas.dembasolution.com
CRON_SECRET=

# Emails de notification (facultatif : sans clé, les notifications restent visibles dans l'application)
RESEND_API_KEY=
EMAIL_EXPEDITEUR=PCAS <notifications@dembasolution.com>

# Notifications push des applications mobiles (facultatif) : contenu JSON du compte de service Firebase
FIREBASE_SERVICE_ACCOUNT=

# Démonstration (connexion en un clic sur /decouvrir-pcas aux comptes fictifs créés par `npm run demo`) : active par
# défaut, cloisonnée en base (migration 13_espace_demo). DEMO_ACTIVE=non coupe la connexion en un clic.
DEMO_ACTIVE=

# Sentry (remontée des erreurs navigateur et serveur) : inactif si vide. DSN : Sentry › Settings › Projects › pcas › Client Keys.
NEXT_PUBLIC_SENTRY_DSN=
# Facultatif, au build seulement : envoi des source maps (piles d'appel lisibles). Sentry › Settings › Auth Tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=pcas

# Surveillance UptimeRobot (npm run surveillance, poste local uniquement) : Integrations & API › Main API key.
UPTIMEROBOT_API_KEY=
